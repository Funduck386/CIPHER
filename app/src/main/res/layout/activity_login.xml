<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E1B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="100dp"
        android:paddingBottom="40dp">

        <!-- Your logo asset goes here -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/logo_cipher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CIPHER"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Encrypt. Protect. Communicate."
            android:textColor="#8891B3"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Welcome Back"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:text="Sign in to continue secure messaging."
            android:textColor="#8891B3"
            android:textSize="14sp" />

        <!-- Google -->
        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_social_button"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Continue with Google"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- GitHub -->
        <Button
            android:id="@+id/btnGithubSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_social_button"
            android:drawableStart="@drawable/ic_github"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Continue with GitHub"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2A3350" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="or"
                android:textColor="#8891B3"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2A3350" />
        </LinearLayout>

        <!-- Guest -->
        <Button
            android:id="@+id/tvGuestMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_guest_button"
            android:text="Continue as Guest"
            android:textColor="#4F6EF7"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>