<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E1B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="40dp">

        <!-- Your logo asset goes here -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/logo_cipher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CIPHER"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Encrypt. Protect. Communicate."
            android:textColor="#8891B3"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Welcome Back"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Log in to your account to continue secure messaging."
            android:textColor="#8891B3"
            android:textSize="14sp" />

        <!-- Email or phone -->
        <EditText
            android:id="@+id/etEmailOrPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="12dp"
            android:paddingHorizontal="16dp"
            android:hint="Email or Phone Number"
            android:textColorHint="#8891B3"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="12dp"
            android:paddingHorizontal="16dp"
            android:hint="Password"
            android:textColorHint="#8891B3"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Log in button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_gradient_button"
            android:text="Log In  →"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="0dp" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2A3350" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="or"
                android:textColor="#8891B3"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2A3350" />
        </LinearLayout>

        <!-- Google -->
        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_social_button"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Continue with Google"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- Apple -->
        <Button
            android:id="@+id/btnAppleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_social_button"
            android:drawableStart="@drawable/ic_apple"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Continue with Apple"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- Phone -->
        <Button
            android:id="@+id/btnPhoneSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_social_button"
            android:drawableStart="@android:drawable/ic_menu_call"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Continue with Phone Number"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- Guest -->
        <Button
            android:id="@+id/tvGuestMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_guest_button"
            android:text="Continue as Guest"
            android:textColor="#4F6EF7"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>